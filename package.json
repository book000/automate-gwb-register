{
  "name": "automate-gwb-register",
  "version": "0.0.0",
  "description": "Automatically register github-webhook-bridge webhooks in the user's repository.",
  "homepage": "https://github.com/book000/automate-gwb-register",
  "bugs": {
    "url": "https://github.com/book000/automate-gwb-register/issues"
  },
  "license": "MIT",
  "author": "Tomachi <tomachi@tomacheese.com>",
  "private": true,
  "main": "dist/main.js",
  "repository": {
    "url": "git@github.com:book000/automate-gwb-register.git",
    "type": "git"
  },
  "scripts": {
    "fix:prettier": "prettier --write src",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "dev": "tsx watch ./src/main.ts",
    "fix": "run-z fix:prettier fix:eslint",
    "preinstall": "npx only-allow pnpm",
    "lint:tsc": "tsc",
    "test": "vitest run",
    "start": "tsx ./src/main.ts",
    "lint:prettier": "prettier --check src",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.17.5",
    "@book000/node-utils": "1.26.33",
    "@octokit/rest": "22.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.10.1",
    "run-z": "2.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0"
}
