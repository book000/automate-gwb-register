  "private": true,
  "main": "dist/main.js",
  "repository": {
    "url": "git@github.com:book000/automate-gwb-register.git",
    "type": "git"
  },
  "scripts": {
    "fix:prettier": "prettier --write src",
    "lint:eslint": "eslint . -c eslint.config.mjs",
    "dev": "tsx watch ./src/main.ts",
    "fix": "run-z fix:prettier fix:eslint",
    "preinstall": "npx only-allow pnpm",
    "lint:tsc": "tsc",
    "start": "tsx ./src/main.ts",
    "lint:prettier": "prettier --check src",
    "fix:eslint": "eslint . -c eslint.config.mjs --fix",
    "lint": "run-z lint:prettier,lint:eslint,lint:tsc"
  },
  "devDependencies": {
    "@book000/eslint-config": "1.16.79",
    "@book000/node-utils": "1.25.134",
    "@octokit/rest": "22.0.1",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.4.0",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.9.9",
    "run-z": "2.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45"
